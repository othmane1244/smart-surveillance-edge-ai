# Variables lues par database.py (python-dotenv charge le fichier .env à la racine).
# Copier ce fichier en .env et remplacer les valeurs factices. Ne jamais committer .env.
# Sans ces deux variables, l'API démarre en mode simulation (alertes gardées en mémoire).

SUPABASE_URL=https://votre-projet.supabase.co
# Clé service_role : à utiliser UNIQUEMENT côté serveur (cette API), jamais dans le dashboard
SUPABASE_SERVICE_KEY=votre-cle-service-role
