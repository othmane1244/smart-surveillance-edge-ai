# Variables lues par lib/supabase.ts. Copier ce fichier en .env.local et remplacer les valeurs factices.
# Les variables NEXT_PUBLIC_* sont envoyées au navigateur : n'y mettre que la clé anon (publique).
# NE JAMAIS mettre la clé service_role ici : elle contourne la sécurité (RLS) de Supabase.
# Ces deux variables sont obligatoires : sans elles, le dashboard ne démarre pas.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
